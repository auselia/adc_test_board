	(text "SENSOR IN (J1) = bias-T for the sensor head. +5V -> 47R (R26, C32 filter) -> 470 uH (L2) -> coax centre. C33 100 nF passes the head's signal to SIG_IN."
		(exclude_from_sim no)
		(at 20 360 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "f90e991b-d00e-4654-9ace-54d1d33a93db")
	)
	(text "R27 1M gives SIG_IN a DC level (VMID5). To feed a function generator or a perfboard instead, cut the solder jumper JP1 (bridged by a copper trace) so the centre pin carries no DC."
		(exclude_from_sim no)
		(at 20 366 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "6f2b7bdc-452d-4877-a9cc-2393c143f44b")
	)
