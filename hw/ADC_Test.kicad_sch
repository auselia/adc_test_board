	(text "SENSOR IN (J1) = bias-T for the sensor head. +5V -> 47R (R26, C32 filter) -> 470 uH (L2) -> coax centre. C33 100 nF passes the head's signal to SIG_IN."
		(exclude_from_sim no)
		(at 20 360 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "e3763a5f-a9f2-4157-b088-b4dd708c166a")
	)
	(text "R27 1M gives SIG_IN a DC level (VMID5). To feed a function generator or a perfboard instead, remove R26 so the centre pin carries no DC."
		(exclude_from_sim no)
		(at 20 366 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "d2b8e53c-f455-4bbd-8556-e8d959e3d7e5")
	)
