		(uuid "0776504f-01bf-452f-91d1-cdd40923f744")
	)
	(text "AFE v0.1 topology rebuilt around JLC Basic parts (100 pF C0G, E12 resistors, AMS1117, LM393). Power: 5 V (USB-C or header) -> SS14 -> ferrite -> +5V, AVDD = XC6206 3.3 V from 5 V. DVDD = PMOD 3.3 V."
		(exclude_from_sim no)
		(at 20 35 0)
		(effects
