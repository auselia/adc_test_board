	(text "HEAD IN (J5): bias-T. +5V -> 47R (R26, C32 filter) -> 470 uH (L2) -> coax centre = power for the sensor head. C33 100 nF passes the head's signal to SIG_IN."
		(exclude_from_sim no)
		(at 20 360 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "002bafe7-06ca-491e-bb47-e5e1f72d2065")
	)
	(text "R27 1M gives SIG_IN a DC level (VMID5). J1 (SMA in) stays as before, for a perfboard or a function generator. Use one input at a time."
		(exclude_from_sim no)
		(at 20 366 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
