	(text "SENSOR HEAD (own board, same panel). Perfboard charge amp (TRL3): piezo -> summing node HSUM, Rf 1M || Cf 47 pF, Rs 49.9R. Runs from the 3.3 V rail through the coax (L1), signal returns through C38. HQ (default): OPA365 + Cf 47 pF in C34. LP: OPA314 + Cf 100 pF in C34 (0402 C0G C1546)."
		(exclude_from_sim no)
		(at 220 360 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "1e8573a7-088e-4389-978c-88a7afc01e12")
	)
	(text "SOT-23-5 for OPA365 or OPA314 (same pinout), VREF = V+/2 (1M/1M + 10 uF, 1.6 uA), all 0402. Head ground is HGND (a separate board)."
		(exclude_from_sim no)
		(at 220 366 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "fd93f196-c622-409e-9b60-491dc22695bd")
	)
