	(text "SENSOR IN (J1) = bias-T for the sensor head. +3V3 -> 47R (R26, C32 filter) -> JP1 -> 470 uH (L2) -> coax centre. C33 100 nF passes the head's signal to SIG_IN."
		(exclude_from_sim no)
		(at 20 360 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "001039a6-9fb7-4639-ac21-cc3e6d298b25")
	)
	(text "R27 1M gives SIG_IN a DC level (VMID5). To feed a function generator or a perfboard instead, cut the solder jumper JP1 (bridged by a copper trace) so the centre pin carries no DC."
		(exclude_from_sim no)
		(at 20 366 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left bottom)
		)
		(uuid "6b80d6e6-079f-4461-a404-522e5cb8991b")
	)
