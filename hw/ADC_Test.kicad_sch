			)
			(justify left bottom)
		)
		(uuid "1ff45c89-1271-4ecf-a359-bc5d174754d8")
	)
	(text "Input, high-pass filter (Sallen-Key, 100 pF / 10k / 20k: f0 = 113 kHz, Q = 0.71), gain 1 + 3.9k/1k = 4.9"
