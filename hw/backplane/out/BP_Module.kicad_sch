	(text "8-slot backplane module for the ADS7057 channel cards"
		(exclude_from_sim no)
		(at 20 22 0)
		(effects
			(font
				(size 5 5)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "da78eb63-6ff1-4577-a7b1-c31d772ce6e7")
	)
	(text "Each card stands perpendicular to the board with its components facing +X (arrow on the silkscreen). Socket pad numbers are NOT the card pin numbers: the two header rows swap, so card pin 1 CS lands on pad 2, card pin 2 BIG_N on pad 1, pin 5 SDO on pad 6, pin 7 SCLK on pad 8, pin 8 WAKE_N on pad 7."
		(exclude_from_sim no)
		(at 20 32 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "cd8c10e5-eca6-4550-a623-8a0184f29c46")
	)
	(text "Cards 0+1 share SDO lane 0, 2+3 lane 1, 4+5 lane 2, 6+7 lane 3 (SDO is Hi-Z while the card's CS is high). SCLK is buffered (SN74LVC244A, 22 R per branch). 5 V in -> SS14 -> TPS7A8300 ANY-OUT 3.3 V (pins 100 mV + 800 mV + 1.6 V to GND: 0.8 + 0.1 + 0.8 + 1.6 = 3.3 V)."
		(exclude_from_sim no)
		(at 20 38 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "a64535dc-53e0-487a-a583-7376f8a17cae")
	)
	(text "100 k pull-ups keep CS, WAKE_N and BIG_N high when a slot is empty or the adapter is not powered."
		(exclude_from_sim no)
		(at 20 44 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "a208a010-35dc-4eee-aec8-1a40520a26e9")
	)
